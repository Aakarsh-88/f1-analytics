# =============================================================================
# F1 Analytics Backend — Environment Variables
# Copy this file to `.env` in the same directory and fill in real values.
# NEVER commit the real `.env` file to git.
# =============================================================================

# --- App ---
APP_NAME="F1 Analytics API"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (Postgres running in Docker) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=f1_analytics
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/f1_analytics
# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Caching (Redis) ---
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Auth (Clerk) — wired in Milestone 6, present now so config doesn't change later ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=

# --- Logging ---
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true in production for structured logs

# --- Pagination defaults ---
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100
